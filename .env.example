# FailureDNA Environment Variables
# Copy to .env and customize as needed

# Project Paths
FAILUREDNA_DATA_DIR=data/raw
FAILUREDNA_PROCESSED_DIR=data/processed
FAILUREDNA_OUTPUT_DIR=reports/results

# Global Random Seed
FAILUREDNA_SEED=42

# Execution Device: 'cpu' or 'cuda'
FAILUREDNA_DEVICE=cpu

# Logging Configuration: DEBUG, INFO, WARNING, ERROR
FAILUREDNA_LOG_LEVEL=INFO

# MLflow Tracking URI
FAILUREDNA_MLFLOW_TRACKING_URI=file:./mlruns
